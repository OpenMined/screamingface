{
  "name": "screamingface-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "ScreamingFace desktop control plane",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenMined/screamingface.git",
    "directory": "apps/desktop"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder",
    "prepare": "cd ../.. && husky apps/desktop/.husky",
    "lint": "eslint . --fix",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@rjsf/core": "^6.6.2",
    "@rjsf/utils": "^6.4.1",
    "@rjsf/validator-ajv8": "^6.6.2",
    "@softarc/native-federation": "^4.2.1",
    "@softarc/native-federation-runtime": "^4.1.2",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.12.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.5",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "~43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "lucide-react": "^1.23.0",
    "prettier": "^3.9.4",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.7",
    "tw-animate-css": "^1.3.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "ai.screamingface.desktop",
    "productName": "ScreamingFace",
    "icon": "build/icon",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../../apps/server/src",
        "to": "server/src"
      },
      {
        "from": "../../apps/server/pyproject.toml",
        "to": "server/pyproject.toml"
      },
      {
        "from": "../../apps/server/uv.lock",
        "to": "server/uv.lock"
      },
      {
        "from": "../../apps/server/sf.json",
        "to": "server/sf.json"
      },
      {
        "from": "../../apps/aigateway/src",
        "to": "aigateway/src"
      },
      {
        "from": "../../apps/aigateway/pyproject.toml",
        "to": "aigateway/pyproject.toml"
      },
      {
        "from": "../../apps/aigateway/uv.lock",
        "to": "aigateway/uv.lock"
      },
      {
        "from": "build-assets/${os}/${arch}/uv",
        "to": "server/bin/uv"
      },
      {
        "from": "build-assets/${os}/${arch}/python",
        "to": "server/python"
      },
      {
        "from": "build-assets/${os}/${arch}/cache.tar.gz",
        "to": "server/cache.tar.gz"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "artifactName": "ScreamingFace-${version}-${os}-${arch}.${ext}",
    "publish": null
  }
}
