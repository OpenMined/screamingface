{
  "name": "screamingface-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "ScreamingFace desktop control plane",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenMined/screamingface.git",
    "directory": "apps/desktop"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder",
    "prepare": "cd ../.. && husky apps/desktop/.husky",
    "lint": "eslint . --fix",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@rjsf/core": "^6.4.1",
    "@rjsf/utils": "^6.4.1",
    "@rjsf/validator-ajv8": "^6.4.1",
    "@softarc/native-federation": "^3.5.4",
    "@softarc/native-federation-runtime": "^3.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-react": "^4.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "~41.1.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^9.27.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.1.0",
    "lucide-react": "^0.511.0",
    "prettier": "^3.5.3",
    "shadcn": "^4.0.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.7",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "ai.screamingface.desktop",
    "productName": "ScreamingFace",
    "icon": "build/icon",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../../apps/server/src",
        "to": "server/src"
      },
      {
        "from": "../../apps/server/pyproject.toml",
        "to": "server/pyproject.toml"
      },
      {
        "from": "../../apps/server/uv.lock",
        "to": "server/uv.lock"
      },
      {
        "from": "../../apps/server/sf.json",
        "to": "server/sf.json"
      },
      {
        "from": "build-assets/${os}/${arch}/uv",
        "to": "server/bin/uv"
      },
      {
        "from": "build-assets/${os}/${arch}/python",
        "to": "server/python"
      },
      {
        "from": "build-assets/${os}/${arch}/cache.tar.gz",
        "to": "server/cache.tar.gz"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "artifactName": "ScreamingFace-${version}-${os}-${arch}.${ext}",
    "publish": null
  }
}
