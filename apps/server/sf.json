{
  "version": "0.1.0",
  "server": {
    "host": "0.0.0.0",
    "port": 443,
    "reload": true,
    "ssl": true,
    "ssl_certfile": null,
    "ssl_keyfile": null
  },
  "plugins": [
    "claude-frontend",
    "claude-cli",
    "tracing",
    "url-executor",
    "claude-intercept"
  ],
  "url4config": "https://localhost:{port}/claude/run?p={prompt}",
  "plugin_config": {
    "claude-frontend": {
      "upstream_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY"
    },
    "claude-intercept": {
      "auto_cleanup": true,
      "server_port": 8001
    }
  }
}
