{
  "version": "0.1.0",
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "reload": true,
    "ssl": true,
    "ssl_certfile": null,
    "ssl_keyfile": null
  },
  "plugins": [
    "claude-backend",
    "tracing",
    "url4-executor",
    "claude-env-intercept",
    "url4-specs",
    "claude-frontend"
  ],
  "plugin_config": {
    "claude-frontend": {
      "active_spec": "all-docs",
      "upstream_url": "https://api.anthropic.com",
      "listen_host": "127.0.0.1",
      "listen_port": 9101,
      "domains": [
        "api.anthropic.com"
      ],
      "default_spec": "all-docs"
    },
    "mitmproxy-intercept": {
      "rules": [
        {
          "domain": "api.anthropic.com",
          "frontend": "claude-frontend",
          "process_filter": "claude"
        }
      ],
      "proxy_port": 8888,
      "mitmdump_path": "mitmdump",
      "mitmproxy_ca_cert": "~/.mitmproxy/mitmproxy-ca-cert.pem",
      "auto_cleanup": true,
      "trust_ca": true
    },
    "claude-backend": {
      "default_model": "claude-sonnet-4-20250514",
      "default_effort": "medium",
      "timeout_seconds": 300,
      "max_budget_usd": null,
      "permission_mode": null,
      "dangerously_skip_permissions": false,
      "profiles": {
        "default": {}
      },
      "default_profile": null
    },
    "url4-executor": {
      "profiles": {
        "all-docs": {
          "expression": "(https://localhost:8000/url4?q=(https://docs.a.com, https://docs.b.com),https://localhost:8000/url4?q=(https://docs.c.com, https://docs.d.com))"
        }
      },
      "default_profile": "all-docs"
    },
    "url4-specs": {
      "specs": {
        "all-docs": {
          "expression": "(https://docs.a.com, https://docs.b.com)"
        },
        "news-feed": {
          "expression": "(https://news.com/feed, https://blog.com/rss)"
        },
        "internal-apis": {
          "expression": "(https://api.internal.dev/v1, https://api.internal.dev/v2)"
        },
        "simple-test": {
          "expression": "Hello from url4 spec"
        }
      }
    }
  }
}
