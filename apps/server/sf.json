{
  "version": "0.1.0",
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "reload": true,
    "ssl": true,
    "ssl_certfile": null,
    "ssl_keyfile": null
  },
  "plugins": [
    "claude-proxy",
    "claude-env"
  ],
  "plugin_config": {
    "claude-proxy": {
      "upstream_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY"
    }
  }
}
