{
  "version": "0.1.0",
  "server": {
    "host": "127.0.0.1",
    "port": 8000,
    "reload": true,
    "ssl": false,
    "ssl_certfile": null,
    "ssl_keyfile": null
  },
  "plugins": [
    "tracing",
    "url4-executor",
    "url4-specs",
    "claude-frontend",
    "data-store",
    "llm-base",
    "frontend-base",
    "backend-api-base",
    "python-runner",
    "aigw-codex-backend",
    "aigw-gemini-backend",
    "ollama-backend-api",
    "gemini-frontend",
    "codex-frontend",
    "ollama-frontend",
    "aigw-base",
    "aigw-claude-backend",
    "aigw-runner",
    "state",
    "eval-runs"
  ],
  "plugin_config": {
    "aigw-runner": {
      "port": 9105,
      "aigateway_dir": null,
      "database_path": null,
      "uv_bin": null,
      "auth_enabled": false,
      "startup_timeout_seconds": 60,
      "migrations_timeout_seconds": 30,
      "enabled": true,
      "aigw_env": {
        "AIGW_PROVIDER_MAX_CONCURRENCY": "4",
        "AIGW_PROVIDER_MAX_CONCURRENCY_OVERRIDES": "{\"gemini-cli\":1}"
      }
    },
    "aigw-base": {
      "mode": "local_managed",
      "gateway_url": "http://127.0.0.1:9105"
    },
    "aigw-codex-backend": {
      "gateway_url": "http://127.0.0.1:9105",
      "auth_profile": "default",
      "default_model": "codex/gpt-5.4-mini",
      "default_effort": "medium",
      "timeout_seconds": 600,
      "max_budget_usd": null,
      "permission_mode": null,
      "dangerously_skip_permissions": false,
      "profiles": {
        "default": {
          "context": null,
          "system_prompt": null,
          "append_system_prompt": null,
          "model": null,
          "output_format": null,
          "max_budget_usd": null,
          "effort": null,
          "tools": null,
          "allowed_tools": null,
          "disallowed_tools": null,
          "mcp_config": null,
          "permission_mode": null,
          "add_dirs": null,
          "fallback_model": null,
          "dangerously_skip_permissions": false,
          "no_session_persistence": true,
          "timeout_seconds": null
        }
      },
      "default_profile": "default"
    },
    "aigw-gemini-backend": {
      "gateway_url": "http://127.0.0.1:9105",
      "auth_profile": "default",
      "default_model": "gemini-cli/gemini-2.5-flash-lite",
      "default_effort": "medium",
      "interpreter_system_prompt": "You are a helpful assistant. Answer the user's question based only on the provided context. Be concise and factual.",
      "timeout_seconds": 600,
      "max_budget_usd": null,
      "permission_mode": null,
      "dangerously_skip_permissions": false,
      "profiles": {
        "default": {
          "context": null,
          "system_prompt": null,
          "append_system_prompt": null,
          "model": null,
          "output_format": null,
          "max_budget_usd": null,
          "effort": null,
          "tools": null,
          "allowed_tools": null,
          "disallowed_tools": null,
          "mcp_config": null,
          "permission_mode": null,
          "add_dirs": null,
          "fallback_model": null,
          "dangerously_skip_permissions": false,
          "no_session_persistence": true,
          "timeout_seconds": null
        }
      },
      "default_profile": "default"
    },
    "aigw-claude-backend": {
      "gateway_url": "http://127.0.0.1:9105",
      "auth_profile": "default",
      "default_model": "anthropic/claude-sonnet-4-5",
      "default_effort": "medium",
      "timeout_seconds": 600,
      "max_budget_usd": null,
      "permission_mode": null,
      "dangerously_skip_permissions": false,
      "profiles": {
        "default": {
          "context": null,
          "system_prompt": null,
          "append_system_prompt": null,
          "model": null,
          "output_format": null,
          "max_budget_usd": null,
          "effort": null,
          "tools": null,
          "allowed_tools": null,
          "disallowed_tools": null,
          "mcp_config": null,
          "permission_mode": null,
          "add_dirs": null,
          "fallback_model": null,
          "dangerously_skip_permissions": false,
          "no_session_persistence": true,
          "timeout_seconds": null
        }
      },
      "default_profile": "default"
    },
    "claude-frontend": {
      "active_spec": "anthropic-cookbook",
      "upstream_url": "https://api.anthropic.com",
      "listen_host": "127.0.0.1",
      "listen_port": 9101,
      "session_service_url": "http://127.0.0.1:9200",
      "resolve_timeout": 300
    },
    "ollama-frontend": {
      "active_spec": null,
      "upstream_url": "http://localhost:11434",
      "listen_host": "127.0.0.1",
      "listen_port": 9103,
      "embed_target": "system",
      "embed_mode": "concat",
      "resolve_timeout": 300
    },
    "mitmproxy-intercept": {
      "rules": [
        {
          "domain": "api.anthropic.com",
          "frontend": "claude-frontend",
          "process_filter": "claude"
        },
        {
          "domain": "localhost:11434",
          "frontend": "ollama-frontend",
          "process_filter": "ollama"
        }
      ],
      "proxy_port": 8888,
      "mitmdump_path": "mitmdump",
      "mitmproxy_ca_cert": "~/.mitmproxy/mitmproxy-ca-cert.pem",
      "auto_cleanup": true,
      "trust_ca": true
    },
    "claude-backend-api": {
      "default_model": "claude-sonnet-4-6",
      "default_effort": "medium",
      "timeout_seconds": 300,
      "max_budget_usd": null,
      "permission_mode": null,
      "dangerously_skip_permissions": false,
      "profiles": {
        "default": {
          "context": null,
          "system_prompt": null,
          "append_system_prompt": null,
          "model": null,
          "output_format": null,
          "max_budget_usd": null,
          "effort": null,
          "tools": null,
          "allowed_tools": null,
          "disallowed_tools": null,
          "mcp_config": null,
          "permission_mode": null,
          "add_dirs": null,
          "fallback_model": null,
          "dangerously_skip_permissions": false,
          "no_session_persistence": true,
          "timeout_seconds": null
        }
      },
      "default_profile": "default"
    },
    "ollama-backend-api": {
      "base_url": "http://localhost:11434",
      "api_key": null,
      "default_model": "llama3.2",
      "default_effort": "medium",
      "timeout_seconds": 300,
      "max_budget_usd": null,
      "permission_mode": null,
      "dangerously_skip_permissions": false,
      "profiles": {
        "default": {
          "context": null,
          "system_prompt": null,
          "append_system_prompt": null,
          "model": null,
          "output_format": null,
          "max_budget_usd": null,
          "effort": null,
          "tools": null,
          "allowed_tools": null,
          "disallowed_tools": null,
          "mcp_config": null,
          "permission_mode": null,
          "add_dirs": null,
          "fallback_model": null,
          "dangerously_skip_permissions": false,
          "no_session_persistence": true,
          "timeout_seconds": null
        }
      },
      "default_profile": "default"
    },
    "url4-specs": {
      "specs": {
        "anthropic-cookbook": {
          "expression": "(https://raw.githubusercontent.com/anthropics/anthropic-cookbook/main/README.md)!$prompt"
        },
        "MainOne": {
          "expression": "https://screamingface.ai/livetruth-latest.eval.jsonl*(claude:0.40:/claude($item.question)!'Answer this question. If it is multiple choice, return a probability distribution over the answer choices as JSON. Format: {\"A\": 0.7, \"B\": 0.2, \"C\": 0.05,\"D\": 0.05}. Return only the JSON object.',codex:0.30:/codex($item.question)!'Answer this question. If it is multiple choice, return a probability distribution over the answer choices as JSON. Format: {\"A\": 0.7, \"B\": 0.2, \"C\": 0.05,\"D\": 0.05}. Return only the JSON object.', gemini:0.30:/gemini($item.question)!'Answer this question. If it is multiple choice, return a probability distribution over the answer choices as JSON. Format: {\"A\": 0.7, \"B\": 0.2, \"C\": 0.05,\"D\": 0.05}. Return only the JSON object.')!'Compute a weighted average of these distributions using source weights claude=0.40, codex=0.30, gemini=0.30. Return the single answer letter with the highest combined probability.'"
        },
        "MainTwo": {
          "expression": "https://screamingface.ai/livetruth-latest.eval.jsonl*(claude:0.57:/claude($item.question)!'Answer this question. If it is multiple choice, return a probability distribution over the answer choices as JSON. Format: {\"A\": 0.7, \"B\": 0.2, \"C\": 0.05,\"D\": 0.05}. Return only the JSON object.',codex:0.43:/codex($item.question)!'Answer this question. If it is multiple choice, return a probability distribution over the answer choices as JSON. Format: {\"A\": 0.7, \"B\": 0.2, \"C\": 0.05,\"D\": 0.05}. Return only the JSON object.')!'Compute a weighted average of these distributions using source weights claude=0.57, codex=0.43. Return the single answer letter with the highest combined probability.'"
        }
      }
    }
  }
}
